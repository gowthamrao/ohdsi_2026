# ==============================================================================
# StudyAgent Secrets Configuration Template - OHDSI Sandbox 2026
# Copy to secrets.env (gitignored) for local deployments
# ==============================================================================

# OMOP CDM Database Engine (PostgreSQL)
OMOP_DB_ENGINE=postgresql+psycopg://studyagent_readonly:studyagent_readonly_password@ohdsi-postgres:5432/ohdsi

# StudyAgent Bearer Tokens (Optional for Authenticated Access)
STUDYAGENT_ADMIN_TOKEN=ohdsi-admin-agent-token-2026
STUDYAGENT_STUDY_DESIGNER_TOKEN=ohdsi-study-designer-token-2026
STUDYAGENT_READONLY_TOKEN=ohdsi-readonly-agent-token-2026

# Cloud LLM API Keys (Optional - Local Ollama is default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
