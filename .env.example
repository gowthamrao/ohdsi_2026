# ==============================================================================
# OHDSI 2026 Platform Environment Configuration Template
# ==============================================================================
# Copy to .env and customize for your deployment target.
# ==============================================================================

# Public Domain & Ingress Configuration
DOMAIN=ohdsi.example.org
LETSENCRYPT_EMAIL=admin@example.org

# Database Engine Configuration (PostgreSQL 16)
DB_ADMIN_USER=postgres
DB_ADMIN_PASS=ohdsi_admin_secure_2026
DB_APP_USER=ohdsi_app_user
DB_APP_PASS=ohdsi_app_secure_2026
POSTGRES_DB=ohdsi

# OMOP CDM Schemas (Shared across PostgreSQL, WebAPI, Atlas, and Dedicated R Server)
CDM_SERVER=ohdsi-postgres
CDM_PORT=5432
CDM_DATABASE=ohdsi
CDM_SCHEMA=cdm_synthea100k
VOCAB_SCHEMA=vocab_54
RESULTS_SCHEMA=results

# WebAPI & Atlas Configuration
WEBAPI_URL=http://webapi-classic:8080/WebAPI
ATLAS_URL=http://atlas-classic:80
ATLAS3_ADMIN_PASS=atlas3_admin_secure_2026

# Dedicated R Server (broadsea-hades / RStudio Server)
# Directly connects to OMOP CDM database and WebAPI
HADES_USER=ohdsi
HADES_PASSWORD=ohdsi2026
DATABASECONNECTOR_JAR_FOLDER=/opt/drivers

# StudyAgent FastMCP AI Gateway (Port 8790)
STUDYAGENT_ADMIN_TOKEN=ohdsi-admin-agent-token-2026
STUDYAGENT_STUDY_DESIGNER_TOKEN=ohdsi-study-designer-token-2026
STUDYAGENT_READONLY_TOKEN=ohdsi-readonly-agent-token-2026
STUDYAGENT_DB_USER=studyagent_readonly
STUDYAGENT_DB_PASS=studyagent_secure_pass_2026

# Local Sovereign LLM Inference (Ollama)
OLLAMA_ENDPOINT=http://ollama-service:11434

# Data Privacy & Governance
MIN_CELL_COUNT=5
