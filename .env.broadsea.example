# ==============================================================================
# OHDSI Broadsea 3.5 Environment Configuration Template
# ==============================================================================
# Copy to .env.broadsea or .env for running Broadsea container deployments
# ==============================================================================

# Section 1: Broadsea Host & Protocol
DOCKER_ARCH=linux/amd64
BROADSEA_HOST=127.0.0.1
HTTP_TYPE=http
DOMAIN=ohdsi.org

# Section 2: PostgreSQL & AtlasDB Database Configuration
ATLASDB_HOST=broadsea-atlasdb
ATLASDB_PORT=5432
ATLASDB_NAME=ohdsi
ATLASDB_USER=postgres
ATLASDB_PASSWORD=ohdsi_admin_secure_2026

# Section 3: WebAPI REST Backend
WEBAPI_URL=http://ohdsi-webapi:8080/WebAPI/
WEBAPI_PUBLIC_URL=http://${BROADSEA_HOST}:8080/WebAPI/
WEBAPI_DATASOURCE_URL=jdbc:postgresql://broadsea-atlasdb:5432/ohdsi?currentSchema=webapi
WEBAPI_DATASOURCE_OHDSI_SCHEMA=webapi
FLYWAY_BASELINE_ON_MIGRATE=true
SECURITY_CORS_ENABLED=true

# Section 4: Atlas Web Interface
ATLAS_INSTANCE_NAME=Sovereign OHDSI Broadsea
ATLAS_USER_AUTH_ENABLED=false
ATLAS_CACHE_SOURCES=false
ATLAS_ENABLE_PERSON_COUNT=true

# Section 5: Dedicated R Server (broadsea-hades / RStudio Server)
# Directly connects to OMOP CDM database and WebAPI
HADES_USER=ohdsi
HADES_PASSWORD=ohdsi2026
CDM_SCHEMA=cdm
VOCAB_SCHEMA=vocabulary
RESULTS_SCHEMA=results
DATABASECONNECTOR_JAR_FOLDER=/opt/drivers

# Section 6: Solr Vocabulary Search Engine
SOLR_VOCAB_VERSION=v5.0
SOLR_VOCAB_ENDPOINT=http://broadsea-solr-vocab:8983/solr

# Section 7: Governance & Zero-PHI Privacy
MIN_CELL_COUNT=5
AUTH_REQUIRED=true
